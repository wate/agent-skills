# ユースケース図テンプレート
# =========================
# 目的: アクターと機能の関係を示す
# 対象: 企画、開発チーム

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 0
  }
}

利用者: {
  class: actor
}

管理者: {
  class: actor
}

システム: {
  class: system

  ログイン: {
    class: usecase
  }

  レポート出力: {
    class: usecase
  }

  ユーザー管理: {
    class: usecase
  }
}

利用者 -> システム.ログイン
管理者 -> システム.ログイン
管理者 -> システム.レポート出力
管理者 -> システム.ユーザー管理

classes: {
  actor: {
    shape: person
    style: {
      fill: "#e3f2fd"
      stroke: "#1976d2"
    }
  }
  usecase: {
    shape: oval
    style: {
      fill: "#fff3e0"
      stroke: "#f57c00"
    }
  }
  system: {
    shape: rectangle
    style: {
      fill: "#fafafa"
      stroke: "#9e9e9e"
    }
  }
}
